PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/music_store

# Firma le sessioni, almeno 32 caratteri. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Facoltativi: indirizzo del sito, se diverso da quello di Vite in sviluppo
# FRONTEND_ORIGIN=https://www.example.com
# Invio delle email di reset password con Resend (https://resend.com/api-keys).
# Se manca, in sviluppo il link viene stampato nella console; con NODE_ENV=production
# il server non parte senza RESEND_API_KEY e MAIL_FROM.
# RESEND_API_KEY=re_xxxxxxxxx
# Il mittente deve usare un dominio verificato su Resend (https://resend.com/domains).
# In sviluppo, se manca, si usa l'indirizzo di prova onboarding@resend.dev.
# MAIL_FROM=Sonora <noreply@example.com>
# Online impostalo a production, così il cookie di sessione viaggia solo su HTTPS
# NODE_ENV=production
