PORT=3000
DATABASE_URL=postgres://postgres:password@localhost:5432/music_store

# Firma le sessioni, almeno 32 caratteri. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Facoltativi: indirizzo del sito, se diverso da quello di Vite in sviluppo
# FRONTEND_ORIGIN=https://www.example.com
# Invio delle email (reset password, benvenuto, conferma ordine) con Resend (https://resend.com/api-keys).
# Se manca, in sviluppo le email non partono e vengono segnalate nella console; con NODE_ENV=production
# il server non parte senza RESEND_API_KEY e MAIL_FROM.
# RESEND_API_KEY=re_xxxxxxxxx
# Il mittente deve usare un dominio verificato su Resend (https://resend.com/domains).
# In sviluppo, se manca, si usa l'indirizzo di prova onboarding@resend.dev.
# MAIL_FROM=Sonora <noreply@example.com>
# Online impostalo a production, così il cookie di sessione viaggia solo su HTTPS
# NODE_ENV=production

# Caricamento delle foto dei prodotti su Cloudinary, dal pannello admin.
# Si copia da https://console.cloudinary.com, alla voce "API Keys" (API environment variable).
# Se manca, il resto del sito funziona e le immagini si indicano con un indirizzo.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Pagamento con carta tramite Stripe Checkout. Se mancano, il checkout propone solo il pagamento alla consegna.
# Usa le chiavi della modalità test (https://dashboard.stripe.com/test/apikeys): nessun pagamento è reale.
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
# In locale lo stampa `stripe listen --forward-to localhost:3000/api/stripe/webhook`;
# online è il "Signing secret" del webhook creato su https://dashboard.stripe.com/test/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx
