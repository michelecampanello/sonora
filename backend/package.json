{
  "name": "sonora-backend",
  "version": "0.1.0",
  "description": "API per l'e-commerce di strumenti musicali",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:setup": "set -a && . ./.env && set +a && psql \"$DATABASE_URL\" -q -1 -v ON_ERROR_STOP=1 -f db/schema.sql -f db/seed.sql"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
